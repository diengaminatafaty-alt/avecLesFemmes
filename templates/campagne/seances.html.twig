{% extends 'layout.html.twig' %}

{% block title %}Séances - {{ campagne.nom }} | Avec les femmes{% endblock %}

{% block content %}
    <a class="retour" href="{{ path('app_campagne_show', {id: campagne.id}) }}">&larr; Retour à la campagne</a>

    <div class="tete-page">
        <div>
            <h1>Séances de {{ campagne.nom }}</h1>
            <p class="sous-titre">{{ seances|length }} séances enregistrées</p>
        </div>
    </div>

    {% for seance in seances %}
        <section class="panneau seance" aria-labelledby="seance-{{ seance.id }}">
            <h2 id="seance-{{ seance.id }}">Séance du {{ seance.date }}</h2>

            <div class="totaux">
                <span>Total collecté : <strong>{{ seance.totalCollecte|number_format(0, ',', ' ') }} FCFA</strong></span>
                <span>Total des amendes : <strong>{{ seance.totalAmendes|number_format(0, ',', ' ') }} FCFA</strong></span>
                <span>Contributions caisse sociale : <strong>{{ seance.totalContributionsCaisse|number_format(0, ',', ' ') }} FCFA</strong></span>
            </div>

            <h3>Cotisations</h3>
            <div class="defilement">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Membre</th>
                            <th scope="col">Situation</th>
                            <th scope="col" class="nombre">Épargne</th>
                            <th scope="col" class="nombre">Caisse sociale</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for cotisation in seance.cotisations %}
                        <tr>
                            <td>{{ cotisation.membre }}</td>
                            <td>{{ cotisation.situation }}</td>
                            <td class="nombre">{{ cotisation.montantEpargne|number_format(0, ',', ' ') }} FCFA</td>
                            <td class="nombre">{{ cotisation.contributionCaisse|number_format(0, ',', ' ') }} FCFA</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Aucune cotisation.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <h3>Amendes</h3>
            <div class="defilement">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Membre</th>
                            <th scope="col" class="nombre">Jours de retard</th>
                            <th scope="col" class="nombre">Par jour</th>
                            <th scope="col" class="nombre">Total</th>
                            <th scope="col">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for amende in seance.amendes %}
                        <tr>
                            <td>{{ amende.membre }}</td>
                            <td class="nombre">{{ amende.nombreJours }}</td>
                            <td class="nombre">{{ amende.montantParJour|number_format(0, ',', ' ') }} FCFA</td>
                            <td class="nombre">{{ amende.total|number_format(0, ',', ' ') }} FCFA</td>
                            <td>{{ amende.statut }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">Aucune amende.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% else %}
        <p>Aucune séance pour cette campagne.</p>
    {% endfor %}
{% endblock %}